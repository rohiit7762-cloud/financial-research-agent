# ============================================================
# Financial Research Agent — Environment Variables
# Copy this file to .env and configure your desired API keys.
# ============================================================

# Primary LLM Provider: Google Gemini (Recommended)
# Obtain a free API key at: https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# Alternative LLM Provider: OpenAI (Optional)
# If set, you can switch providers in the UI
OPENAI_API_KEY=your_openai_api_key_here

# Agent Configuration Defaults
DEFAULT_MODEL=gemini-2.0-flash
MAX_ITERATIONS=5
TEMPERATURE=0.1

# RAG & Embeddings Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=data/vector_store
FILINGS_DATA_PATH=data/filings
